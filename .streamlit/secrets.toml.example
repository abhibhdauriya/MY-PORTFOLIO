# Copy this file to secrets.toml (same folder) and fill in your own values.
# secrets.toml is git-ignored — never commit real credentials.
#
# These credentials are used ONLY on first run to create your admin account
# in the database (password is stored bcrypt-hashed, never in plaintext).
# After first run, you can change the password from Admin > Site Settings,
# and these values are no longer read.

admin_username = "abhishek"
admin_password = "change-this-to-a-strong-password"
